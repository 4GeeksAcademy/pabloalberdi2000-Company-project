DATABASE_URL=postgresql://user:password@localhost:5432/brasaland_ats
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Authentication (Hito 4)
SECRET_KEY=your-secret-key-here-CHANGE-ME-IN-PRODUCTION-min-32-chars-required
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Password Reset (Hito 6 - AUTH-03)
RESET_TOKEN_SECRET_KEY=DIFFERENT_SECRET_FOR_RESET_TOKENS_MIN_32_CHARS
