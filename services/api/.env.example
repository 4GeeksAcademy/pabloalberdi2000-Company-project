DATABASE_URL=postgresql://user:password@localhost:5432/brasaland_ats
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins - Separados por coma, sin espacios
# Desarrollo: localhost
# Producción: Dominios reales HTTPS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase Database for Inventory (Dual Database Architecture)
# TinyDB: Users & Auth | Supabase: Business Data (Inventory)
SUPABASE_DATABASE_URL=postgresql://postgres.lpmnfgqkvtbmhdchsyla:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ============================================================
# SEGURIDAD: JWT Authentication (Hito 4)
# ============================================================
# ⚠️ OBLIGATORIO: Generar secretos seguros con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ⚠️ NUNCA usar valores por defecto en producción
# ⚠️ NUNCA commitear secretos reales al repositorio
# ⚠️ Mínimo 32 caracteres
SECRET_KEY=GENERATE_WITH_COMMAND_ABOVE_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ============================================================
# SEGURIDAD: Password Reset (Hito 6 - AUTH-03)
# ============================================================
# ⚠️ DEBE SER DIFERENTE de SECRET_KEY
# ⚠️ Generar con mismo comando de arriba
RESET_TOKEN_SECRET_KEY=GENERATE_DIFFERENT_SECRET_MIN_32_CHARS
RESET_TOKEN_EXPIRE_MINUTES=30

# Resend Email Service
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000
