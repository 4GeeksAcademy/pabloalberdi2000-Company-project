# ============================================
# Brasaland Digital Platform - Environment Variables
# Copiar a .env y configurar valores reales
# ============================================

# ============================================
# Backend (FastAPI)
# ============================================

# JWT Authentication
SECRET_KEY=your-secret-key-here-CHANGE-ME-IN-PRODUCTION-min-32-chars-required
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Password Reset
RESET_TOKEN_SECRET_KEY=DIFFERENT_SECRET_FOR_RESET_TOKENS_MIN_32_CHARS
RESET_TOKEN_EXPIRE_MINUTES=30

# Resend Email Service
# Obtener API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Supabase Database (Inventory System - Dual DB Architecture)
# TinyDB: Users & Auth | Supabase: Business Data (Inventory)
# Formato: postgresql://postgres.XXXXX:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=

# ============================================
# Frontend (Next.js)
# ============================================

# Node Environment
NODE_ENV=development

# ============================================
# RAG System (Knowledge Base)
# ============================================

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional: Only for Qdrant Cloud

# OpenAI API (for embeddings and chat)
OPENAI_API_KEY=sk-...  # Required: Get from https://platform.openai.com/api-keys

# ============================================
# Async Tasks (Celery + Redis)
# ============================================

# Redis URL
REDIS_URL=redis://localhost:6379/0

# ============================================
# Docker Compose
# ============================================

# Los valores arriba son usados automáticamente por docker-compose.yml
# No es necesario duplicarlos aquí
